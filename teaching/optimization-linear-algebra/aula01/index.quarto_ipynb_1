        "    theta = np.linspace(0, 2 * np.pi, resolution)\n",
        "    x = np.cos(theta)\n",
        "    y = np.sin(theta)\n",
        "    \n",
        "    if norm_type == 'l1':\n",
        "        # Normalizing points to have L1 norm equal to 1\n",
        "        norm = np.abs(x) + np.abs(y)\n",
        "    elif norm_type == 'l2':\n",
