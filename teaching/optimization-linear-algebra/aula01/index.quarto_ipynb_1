        "        # Normalizing points to have L-infinity norm equal to 1\n",
        "        norm = np.maximum(np.abs(x), np.abs(y))\n",
        "    else:\n",
        "        raise ValueError(\"Invalid norm type. Choose 'l1', 'l2', or 'linf'.\")\n",
        "        \n",
