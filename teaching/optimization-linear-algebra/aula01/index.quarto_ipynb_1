        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from typing import Tuple\n",
        "\n",
        "def compute_unit_ball(norm_type: str, resolution: int = 1000) -> Tuple[np.ndarray, np.ndarray]:\n",
        "    \"\"\"\n",
        "    Computes the coordinates of the unit ball for a given norm.\n",
        "    \n",
        "    Args:\n",
