        "#| echo: false\n",
        "#| fig-align: center\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import make_moons\n",
        "from matplotlib.colors import ListedColormap\n",
        "\n",
        "# Gerando dados em formato de luas (não-linear)\n",
        "X, y = make_moons(n_samples=200, noise=0.15, random_state=42)\n",
        "\n",
        "# Maldição/Grade para testar o k-NN\n",
        "x1_min, x1_max = X[:, 0].min() - 0.5, X[:, 0].max() + 0.5\n",
        "x2_min, x2_max = X[:, 1].min() - 0.5, X[:, 1].max() + 0.5\n",
        "xx1, xx2 = np.meshgrid(np.linspace(x1_min, x1_max, 150),\n",
        "                       np.linspace(x2_min, x2_max, 150))\n",
        "grid_points = np.c_[xx1.ravel(), xx2.ravel()]\n",
        "\n",
        "# Rodando k-NN com k=3 (captura a não-linearidade localmente)\n",
        "k = 3\n",
        "dists_grid = np.linalg.norm(grid_points[:, np.newaxis, :] - X[np.newaxis, :, :], axis=2)\n",
        "nearest_k_idx = np.argsort(dists_grid, axis=1)[:, :k]\n",
        "votes = y[nearest_k_idx]\n",
        "preds = (np.mean(votes, axis=1) >= 0.5).astype(int)\n",
        "Z = preds.reshape(xx1.shape)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(7, 5))\n",
        "ax.contourf(xx1, xx2, Z, cmap=ListedColormap(['#a6cee3', '#fdbf6f']), alpha=0.6)\n",
        "ax.scatter(X[y == 0, 0], X[y == 0, 1], color='#1f77b4', s=40, edgecolors='k', label='Classe 0')\n",
        "ax.scatter(X[y == 1, 0], X[y == 1, 1], color='#ff7f0e', s=40, edgecolors='k', label='Classe 1')\n",
        "ax.set_title(f'$k$-NN bem-sucedido em dados não-lineares ($k={k}$)', fontsize=11, fontweight='bold')\n",
        "ax.legend(loc='upper right')\n",
        "plt.tight_layout()\n",
        "plt.show()"
